@startuml c1-context-smart-home
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста C1 - сервисы Умный дом PropDevelopment

Person(owner, "Собственник", "Пользуется мобильным приложением: ЖКУ, ремонты, умный дом. Открывает домофон и шлагбаум")
Person(guest, "Посетитель", "Гость или курьер. Звонит в домофон, доступ подтверждает собственник")
Person(uk_operator, "Оператор управляющей компании", "Ведёт списки доступа жильцов и транспорта, обрабатывает заявки")
Person(security_officer, "Специалист по ИБ", "Контролирует политики доступа и аудит передачи персональных данных")

System(propdev, "PropDevelopment", "Платформа услуг для собственников: ЖКУ, ремонты, умный дом. Единая точка доступа для собственника")

System_Ext(smart_home_partner, "Партнёрская платформа Умный дом", "Внешний поставщик: управление интеллектуальным домофоном и шлагбаумом, распознавание лиц и автомобильных номеров")
System_Ext(devices, "Оборудование дома", "Домофоны, шлагбаумы, камеры. Подключены к платформе партнёра")
System_Ext(uk_systems, "Системы управляющих компаний", "Данные о ЖК, лицевых счетах и составе жильцов")
System_Ext(payment, "Платёжная система", "Провайдер онлайн-платежей по услугам ЖКУ и подписке на сервисы")
System_Ext(rkn, "Роскомнадзор", "Надзор за обработкой персональных данных, включая биометрию")

Rel(owner, propdev, "Управляет доступом в дом, открывает домофон и шлагбаум, ведёт список своего транспорта", "HTTPS, мобильное приложение")
Rel(guest, devices, "Звонит в домофон", "Аудио- и видеовызов")
Rel(uk_operator, propdev, "Ведёт списки доступа жильцов и транспорта", "HTTPS")
Rel(security_officer, propdev, "Проверяет политики доступа и журналы передачи ПДн", "HTTPS")

Rel(propdev, smart_home_partner, "Запрашивает состояние устройств, отправляет команды открытия, управляет списками доступа и согласиями на биометрию", "HTTPS, REST, OAuth 2.0 / mTLS")
Rel(smart_home_partner, propdev, "Присылает события доступа: проход, проезд, вызов домофона, отказ в доступе", "HTTPS, Webhook с подписью")
Rel(smart_home_partner, devices, "Управляет оборудованием, получает видеопоток и результаты распознавания", "Проприетарный протокол партнёра")
Rel(propdev, uk_systems, "Получает данные о ЖК и составе жильцов для проверки прав доступа", "HTTPS, REST")
Rel(propdev, payment, "Проводит платежи по услугам", "HTTPS, REST")
Rel(propdev, rkn, "Уведомляет об обработке персональных данных и об инцидентах", "Регламентный обмен")

SHOW_LEGEND()
@enduml
